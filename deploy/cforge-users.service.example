[Unit]
Description=CForge users service

[Service]
ExecStart=__CFORGE_ROOT__/build/cforge-users
WorkingDirectory=__CFORGE_ROOT__
Environment=PORT=8080
Environment=TLS_PORT=8443
Environment=CFORGE_BIND=127.0.0.1
Environment=CFORGE_DB=__CFORGE_ROOT__/data/users.db
Environment=CFORGE_TLS_CERT=__CFORGE_ROOT__/deploy/cert.pem
Environment=CFORGE_TLS_KEY=__CFORGE_ROOT__/deploy/key.pem
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
