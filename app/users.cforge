fn ready(ctx: *Ctx) -> i32 {
    return ctx_text(ctx, 200, "ready");
}

fn health(ctx: *Ctx) -> i32 {
    return ctx_text(ctx, 200, "ok");
}

fn metrics(ctx: *Ctx) -> i32 {
    return ctx_metrics(ctx);
}

fn get_user(ctx: *Ctx) -> i32 {
    let id: u64 = 0;
    let prc: i32 = ctx_param_u64(ctx, 0, &id);
    if prc != 0 {
        return ctx_text(ctx, 400, "bad id");
    }
    let name: Slice = slice_empty();
    let age: u32 = 0;
    let oid: u64 = 0;
    let rc: i32 = db_get_user(ctx, id, &oid, &name, &age);
    if rc == 1 {
        return ctx_status(ctx, 404);
    }
    if rc != 0 {
        return ctx_status(ctx, 503);
    }
    return ctx_json_user(ctx, 200, oid, name, age);
}

fn post_user(ctx: *Ctx) -> i32 {
    let name: Slice = slice_empty();
    let age: u32 = 0;
    let jrc: i32 = json_parse_create(ctx, &name, &age);
    if jrc != 0 {
        return ctx_problem(ctx, 400, "bad json", "request body is not valid JSON for create user");
    }
    if name.len == 0 {
        return ctx_text(ctx, 400, "bad name");
    }
    if name.len > 256 {
        return ctx_text(ctx, 400, "bad name");
    }
    let id: u64 = 0;
    let rc: i32 = db_insert_user(ctx, name, age, &id);
    if rc != 0 {
        return ctx_status(ctx, 503);
    }
    return ctx_json_id(ctx, 201, id);
}

fn delete_user(ctx: *Ctx) -> i32 {
    let id: u64 = 0;
    let prc: i32 = ctx_param_u64(ctx, 0, &id);
    if prc != 0 {
        return ctx_text(ctx, 400, "bad id");
    }
    let rc: i32 = db_delete_user(ctx, id);
    if rc == 1 {
        return ctx_status(ctx, 404);
    }
    if rc != 0 {
        return ctx_status(ctx, 503);
    }
    return ctx_status(ctx, 204);
}

fn main() -> i32 {
    app_get("/health", health);
    app_get("/ready", ready);
    app_get("/metrics", metrics);
    app_get("/users/:id", get_user);
    app_post("/users", post_user);
    app_delete("/users/:id", delete_user);
    return app_listen(0);
}
