def main(argv):
    cmd = argv[1] if len(argv) > 1 else "help"
    if cmd == "build":
        print(build())
    elif cmd == "check":
        check_only()
    elif cmd == "run":
        bin_path = build()
        os.execv(bin_path, [bin_path])
    elif cmd == "test":
        test()
    elif cmd == "deploy":
        deploy()
    elif cmd == "e2e":
        e2e()
    elif cmd == "everything":
        everything()
    elif cmd == "deploy-docker":
        deploy_docker()
    elif cmd == "status":
        status()
    elif cmd == "package":
        package_lock()
    elif cmd == "all":
        all_in_one()
    elif cmd == "machine":
        machine(argv)
    elif cmd == "machine-test":
        machine_test()
    else:
        print("usage: cforge build | check | run | test | deploy | e2e | everything | deploy-docker | status | package | all | machine | machine-test")
        if cmd != "help":
            return 2
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except CompileError as exc:
        print("compile error: %s" % exc, file=sys.stderr)
        sys.exit(1)
    except subprocess.CalledProcessError as exc:
        print("command failed: %s" % exc, file=sys.stderr)
        sys.exit(exc.returncode or 1)
