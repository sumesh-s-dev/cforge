def machine(argv):
    from cforge_mach import compile_machine

    if len(argv) < 3:
        raise SystemExit("usage: cforge machine <file.cforge> [-o out]")
    src = argv[2]
    out = os.path.join(ROOT, "build", "cforge-mach")
    if "-o" in argv:
        out = argv[argv.index("-o") + 1]
    path, listing = compile_machine(src, out)
    print(path)
    for line in listing:
        print(line)
    return path


def machine_test():
    from cforge_mach import compile_machine

    cases = [
        ("mach/add.cforge", 5),
        ("mach/expr.cforge", 42),
    ]
    for rel, expect in cases:
        src = os.path.join(ROOT, rel)
        out = os.path.join(ROOT, "build", os.path.splitext(os.path.basename(rel))[0])
        compile_machine(src, out)
        proc = subprocess.run([out], check=False)
        if proc.returncode != expect:
            raise SystemExit("%s exited %s, expected %s" % (rel, proc.returncode, expect))
        print("ok %s -> %s" % (rel, expect))


def package_lock():
    paths = ["cforge", "cforge_mach.py", "cforge.toml", "app/users.cforge"]
    for name in sorted(os.listdir(os.path.join(ROOT, "runtime"))):
        if name.endswith((".c", ".h")):
            paths.append("runtime/" + name)
    lines = ["# cforge.lock — reproducible build fingerprints", ""]
    for rel in sorted(set(paths)):
        path = os.path.join(ROOT, rel)
        if not os.path.isfile(path):
            continue
        digest = hashlib.sha256(open(path, "rb").read()).hexdigest()
        lines.append("%s %s" % (rel, digest))
    lock = os.path.join(ROOT, "cforge.lock")
    with open(lock, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    print(lock)


