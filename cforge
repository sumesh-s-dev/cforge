ROOT = os.path.dirname(os.path.abspath(__file__))

KEYWORDS = {"fn", "let", "if", "else", "while", "return", "struct"}
RUNTIME = {
    "slice_empty",
    "ctx_param_u64",
    "ctx_status",
    "ctx_text",
    "ctx_problem",
    "ctx_json_user",
    "ctx_json_id",
    "ctx_metrics",
    "json_parse_create",
    "db_get_user",
    "db_insert_user",
    "db_delete_user",
    "app_get",
    "app_post",
    "app_delete",
    "app_listen",
}
BASE_TYPES = {
    "i32": "int32_t",
    "u32": "uint32_t",
    "u64": "uint64_t",
    "i64": "int64_t",
    "u16": "uint16_t",
    "u8": "uint8_t",
    "bool": "int32_t",
    "Slice": "Slice",
    "Ctx": "Ctx",
}
STRUCT_TYPES = set()


class CompileError(Exception):
    pass


class Tok:
    def __init__(self, kind, value, line):
        self.kind = kind
        self.value = value
        self.line = line


def lex(src):
    tokens = []
    i = 0
    line = 1
    n = len(src)
    while i < n:
        c = src[i]
        if c == "\n":
            line += 1
            i += 1
            continue
        if c in " \t\r":
            i += 1
            continue
        if c == "@":
            i += 1
            while i < n and (src[i].isalnum() or src[i] == "_"):
                i += 1
            continue
        if c == "/" and i + 1 < n and src[i + 1] == "/":
            while i < n and src[i] != "\n":
                i += 1
            continue
        if c == '"':
            i += 1
            chars = []
            while i < n and src[i] != '"':
                if src[i] == "\n":
                    raise CompileError(f"{line}: newline in string")
                if src[i] == "\\":
                    i += 1
                    if i >= n:
                        raise CompileError(f"{line}: bad escape")
                    esc = src[i]
                    mapping = {"n": "\n", "t": "\t", "r": "\r", '"': '"', "\\": "\\", "/": "/"}
                    if esc not in mapping:
                        raise CompileError(f"{line}: bad escape")
                    chars.append(mapping[esc])
                else:
                    chars.append(src[i])
                i += 1
            if i >= n or src[i] != '"':
                raise CompileError(f"{line}: unterminated string")
            i += 1
            tokens.append(Tok("str", "".join(chars), line))
            continue
        if c.isdigit():
            start = i
            while i < n and src[i].isdigit():
                i += 1
            tokens.append(Tok("num", src[start:i], line))
            continue
        if c.isalpha() or c == "_":
            start = i
            while i < n and (src[i].isalnum() or src[i] == "_"):
                i += 1
            word = src[start:i]
            kind = "kw" if word in KEYWORDS else "ident"
            tokens.append(Tok(kind, word, line))
            continue
        two = src[i : i + 2]
        if two in ("==", "!=", "<=", ">=", "->"):
            tokens.append(Tok(two, two, line))
            i += 2
            continue
        if c in "(){}[],;:.=+-*/<>&!":
            tokens.append(Tok(c, c, line))
            i += 1
            continue
        raise CompileError(f"{line}: unexpected {c!r}")
    tokens.append(Tok("eof", "", line))
    return tokens


class Parser:
    def __init__(self, tokens):
        self.toks = tokens
        self.i = 0

    def cur(self):
        return self.toks[self.i]

    def at(self, kind, value=None):
        t = self.cur()
        if t.kind != kind:
            return False
        if value is not None and t.value != value:
            return False
        return True

    def eat(self, kind, value=None):
        if not self.at(kind, value):
            t = self.cur()
            raise CompileError(f"{t.line}: expected {value or kind}, got {t.kind} {t.value}")
        t = self.cur()
        self.i += 1
        return t

    def parse(self):
        structs = []
        fns = []
        while not self.at("eof"):
            if self.at("kw", "struct"):
                structs.append(self.parse_struct())
            else:
                fns.append(self.parse_fn())
        if not any(fn["name"] == "main" for fn in fns):
            raise CompileError("missing main")
        return {"structs": structs, "fns": fns}

    def parse_struct(self):
        self.eat("kw", "struct")
        name = self.eat("ident").value
        self.eat("{")
        fields = []
        while not self.at("}"):
            fname = self.eat("ident").value
            self.eat(":")
            ftype = self.parse_type()
            self.eat(";")
            fields.append({"name": fname, "type": ftype})
        self.eat("}")
        return {"name": name, "fields": fields}

    def parse_fn(self):
        line = self.eat("kw", "fn").line
        name = self.eat("ident").value
        self.eat("(")
        params = []
        if not self.at(")"):
            params.append(self.parse_param())
            while self.at(","):
                self.eat(",")
                params.append(self.parse_param())
        self.eat(")")
        self.eat("->")
        ret = self.parse_type()
        body = self.parse_block()
        return {"name": name, "params": params, "ret": ret, "body": body, "line": line}

    def parse_param(self):
        name = self.eat("ident").value
        self.eat(":")
        return {"name": name, "type": self.parse_type()}

    def parse_type(self):
        stars = 0
        while self.at("*"):
            self.eat("*")
            stars += 1
        name = self.eat("ident").value
        if name not in BASE_TYPES and name not in STRUCT_TYPES:
            raise CompileError(f"unknown type {name}")
        return {"name": name, "stars": stars}

    def parse_block(self):
        self.eat("{")
        stmts = []
        while not self.at("}"):
            stmts.append(self.parse_stmt())
        self.eat("}")
        return stmts

    def parse_stmt(self):
        if self.at("ident") and self.cur().value in ("add", "sub", "mov", "ret", "syscall"):
            nxt = self.toks[self.i + 1]
            if nxt.kind != "(":
                return self.parse_insn()
        if self.at("kw", "return"):
            line = self.eat("kw", "return").line
            expr = self.parse_expr()
            self.eat(";")
            return {"op": "return", "expr": expr, "line": line}
        if self.at("kw", "let"):
            line = self.eat("kw", "let").line
            name = self.eat("ident").value
            self.eat(":")
            typ = self.parse_type()
            self.eat("=")
            expr = self.parse_expr()
            self.eat(";")
            return {"op": "let", "name": name, "type": typ, "expr": expr, "line": line}
        if self.at("kw", "if"):
            return self.parse_if()
        if self.at("kw", "while"):
            line = self.eat("kw", "while").line
            cond = self.parse_expr()
            body = self.parse_block()
            return {"op": "while", "cond": cond, "body": body, "line": line}
        line = self.cur().line
        expr = self.parse_expr()
        self.eat(";")
        return {"op": "expr", "expr": expr, "line": line}

    def parse_insn(self):
        line = self.cur().line
        mnem = self.eat("ident").value
        args = []
        if mnem not in ("ret", "syscall"):
            args.append(self.parse_operand())
            while self.at(","):
                self.eat(",")
                args.append(self.parse_operand())
        self.eat(";")
        return {"op": "insn", "mnem": mnem, "args": args, "line": line}

    def parse_operand(self):
        if self.at("num"):
            return {"kind": "imm", "value": int(self.eat("num").value, 10)}
        name = self.eat("ident").value
        if len(name) >= 2 and name[0] == "r" and name[1:].isdigit():
            idx = int(name[1:])
            if idx <= 7:
                return {"kind": "reg", "value": idx}
        raise CompileError(f"machine operand must be r0-r7 or an integer, got {name}")

    def parse_if(self):
        line = self.eat("kw", "if").line
        cond = self.parse_expr()
        body = self.parse_block()
        els = None
        if self.at("kw", "else"):
            self.eat("kw", "else")
            if self.at("kw", "if"):
                els = [self.parse_if()]
            else:
                els = self.parse_block()
        return {"op": "if", "cond": cond, "body": body, "else": els, "line": line}

    def parse_expr(self):
        return self.parse_bin(("==", "!=", "<", ">", "<=", ">="), self.parse_add)

    def parse_add(self):
        return self.parse_bin(("+", "-"), self.parse_mul)

    def parse_mul(self):
        return self.parse_bin(("*", "/"), self.parse_unary)

    def parse_bin(self, ops, lower):
        left = lower()
        while self.cur().kind in ops:
            op = self.eat(self.cur().kind).value
            right = lower()
            left = {"op": "bin", "bin": op, "left": left, "right": right}
        return left

    def parse_unary(self):
        if self.cur().kind in ("&", "!", "-"):
            op = self.eat(self.cur().kind).value
            return {"op": "unary", "unary": op, "expr": self.parse_unary()}
        return self.parse_postfix()

    def parse_postfix(self):
        expr = self.parse_primary()
        while True:
            if self.at("("):
                self.eat("(")
                args = []
                if not self.at(")"):
                    args.append(self.parse_expr())
                    while self.at(","):
                        self.eat(",")
                        args.append(self.parse_expr())
                self.eat(")")
                expr = {"op": "call", "fn": expr, "args": args}
            elif self.at("."):
                self.eat(".")
                field = self.eat("ident").value
                if field not in ("len", "ptr"):
                    raise CompileError(f"unknown field {field}")
                expr = {"op": "field", "expr": expr, "field": field}
            else:
                break
        return expr

    def parse_primary(self):
        t = self.cur()
        if t.kind == "num":
            self.i += 1
            return {"op": "num", "value": t.value}
        if t.kind == "str":
            self.i += 1
            return {"op": "str", "value": t.value}
        if t.kind == "ident":
            self.i += 1
            return {"op": "ident", "value": t.value}
        if t.kind == "(":
            self.eat("(")
            expr = self.parse_expr()
            self.eat(")")
            return expr
        raise CompileError(f"{t.line}: expected expression, got {t.kind} {t.value}")


def ctype(typ):
    base = BASE_TYPES.get(typ["name"], typ["name"])
    if typ["stars"]:
        return base + " " + "* " * typ["stars"]
    return base


def c_string(text):
    out = ['"']
    for ch in text:
        o = ord(ch)
        if ch == "\\":
            out.append("\\\\")
        elif ch == '"':
            out.append('\\"')
        elif ch == "\n":
            out.append("\\n")
        elif ch == "\r":
            out.append("\\r")
        elif ch == "\t":
            out.append("\\t")
        elif 32 <= o < 127:
            out.append(ch)
        else:
            out.append("\\x%02x" % o)
    out.append('"')
    return "".join(out)


def gen_expr(expr, env, functions):
    op = expr["op"]
    if op == "num":
        return expr["value"]
    if op == "str":
        raw = expr["value"]
        return "(Slice){.ptr=(uint8_t*)%s, .len=%d}" % (c_string(raw), len(raw.encode("utf-8")))
    if op == "ident":
        name = expr["value"]
        if name in env or name in functions or name in RUNTIME:
            return name
        raise CompileError(f"unknown name {name}")
    if op == "unary":
        return "(%s%s)" % (expr["unary"], gen_expr(expr["expr"], env, functions))
    if op == "bin":
        return "(%s %s %s)" % (
            gen_expr(expr["left"], env, functions),
            expr["bin"],
            gen_expr(expr["right"], env, functions),
        )
    if op == "field":
        return "(%s).%s" % (gen_expr(expr["expr"], env, functions), expr["field"])
    if op == "call":
        if expr["fn"]["op"] != "ident":
            raise CompileError("call target must be a function name")
        fname = expr["fn"]["value"]
        if fname not in functions and fname not in RUNTIME:
            raise CompileError(f"unknown function {fname}")
        args = ", ".join(gen_expr(a, env, functions) for a in expr["args"])
        return "%s(%s)" % (fname, args)
    raise CompileError("bad expr")


def gen_block(stmts, env, functions, indent):
    lines = []
    pad = "    " * indent
    for stmt in stmts:
        op = stmt["op"]
        if op == "let":
            if stmt["name"] in env:
                raise CompileError(f"{stmt['line']}: duplicate {stmt['name']}")
            env[stmt["name"]] = stmt["type"]
            lines.append(
                "%s%s %s = %s;"
                % (pad, ctype(stmt["type"]), stmt["name"], gen_expr(stmt["expr"], env, functions))
            )
        elif op == "insn":
            raise CompileError(
                "%s: raw instruction `%s` is compiled by `cforge machine`, not the C runtime path"
                % (stmt["line"], stmt["mnem"])
            )
        elif op == "return":
            lines.append("%sreturn %s;" % (pad, gen_expr(stmt["expr"], env, functions)))
        elif op == "expr":
            lines.append("%s%s;" % (pad, gen_expr(stmt["expr"], env, functions)))
        elif op == "while":
            lines.append("%swhile (%s) {" % (pad, gen_expr(stmt["cond"], env, functions)))
            lines.extend(gen_block(stmt["body"], env, functions, indent + 1))
            lines.append("%s}" % pad)
        elif op == "if":
            lines.append("%sif (%s) {" % (pad, gen_expr(stmt["cond"], env, functions)))
            lines.extend(gen_block(stmt["body"], env, functions, indent + 1))
            lines.append("%s}" % pad)
            if isinstance(stmt["else"], list) and stmt["else"] and stmt["else"][0]["op"] == "if":
                # else if: attach by rewriting the next if with an else prefix
                nxt = stmt["else"][0]
                lines[-1] = "%s} else if (%s) {" % (pad, gen_expr(nxt["cond"], env, functions))
                lines.extend(gen_block(nxt["body"], env, functions, indent + 1))
                lines.append("%s}" % pad)
                if nxt["else"] is not None:
                    lines[-1] = "%s} else {" % pad
                    if isinstance(nxt["else"], list) and nxt["else"] and nxt["else"][0].get("op") == "if":
                        raise CompileError("else-if chain too deep for this compiler")
                    lines.extend(gen_block(nxt["else"], env, functions, indent + 1))
                    lines.append("%s}" % pad)
            elif stmt["else"] is not None:
                lines[-1] = "%s} else {" % pad
                lines.extend(gen_block(stmt["else"], env, functions, indent + 1))
                lines.append("%s}" % pad)
        else:
            raise CompileError("bad stmt")
    return lines


def emit(parsed):
    structs = parsed["structs"]
    fns = parsed["fns"]
    for s in structs:
        STRUCT_TYPES.add(s["name"])
    names = {fn["name"] for fn in fns}
    lines = [
        '#include "cforge_rt.h"',
        "",
    ]
    for st in structs:
        lines.append("typedef struct %s {" % st["name"])
        for field in st["fields"]:
            lines.append("    %s %s;" % (ctype(field["type"]), field["name"]))
        lines.append("} %s;" % st["name"])
        lines.append("")
    for fn in fns:
        cname = "cforge_main" if fn["name"] == "main" else fn["name"]
        params = ", ".join("%s %s" % (ctype(p["type"]), p["name"]) for p in fn["params"]) or "void"
        lines.append("static %s %s(%s);" % (ctype(fn["ret"]), cname, params))
    lines.append("")
    for fn in fns:
        cname = "cforge_main" if fn["name"] == "main" else fn["name"]
        params = ", ".join("%s %s" % (ctype(p["type"]), p["name"]) for p in fn["params"]) or "void"
        lines.append("static %s %s(%s) {" % (ctype(fn["ret"]), cname, params))
        env = {p["name"]: p["type"] for p in fn["params"]}
        # Function names are visible as pointers inside the body.
        lines.extend(gen_block(fn["body"], env, names, 1))
        lines.append("}")
        lines.append("")
    lines.append("int main(void) { return cforge_main(); }")
    lines.append("")
    return "\n".join(lines)


def read_entry():
    path = os.path.join(ROOT, "cforge.toml")
    entry = "app/users.cforge"
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line.startswith("entry"):
                entry = line.split("=", 1)[1].strip().strip('"')
    return os.path.join(ROOT, entry)


def compile_cforge(src_path, out_c):
    global STRUCT_TYPES
    STRUCT_TYPES = set()
    with open(src_path, encoding="utf-8") as f:
        src = f.read()
    parsed = Parser(lex(src)).parse()
    os.makedirs(os.path.dirname(out_c), exist_ok=True)
    with open(out_c, "w", encoding="utf-8") as f:
        f.write(emit(parsed))


def cc_cmd(out_bin):
    gen = os.path.join(ROOT, "build", "users.gen.c")
    flags = subprocess.check_output(["pkg-config", "--cflags", "--libs", "sqlite3"], text=True).split()
    defs = []
    if subprocess.call(["pkg-config", "--exists", "libpq"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0:
        flags.extend(subprocess.check_output(["pkg-config", "--cflags", "--libs", "libpq"], text=True).split())
        defs.append("-DCFORGE_HAS_PG")
    return [
        "cc",
        "-std=c11",
        "-O2",
        "-g",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-D_GNU_SOURCE",
        *defs,
        "-I",
        os.path.join(ROOT, "runtime"),
        "-o",
        out_bin,
        gen,
        os.path.join(ROOT, "runtime", "server.c"),
        os.path.join(ROOT, "runtime", "json.c"),
        os.path.join(ROOT, "runtime", "db.c"),
        os.path.join(ROOT, "runtime", "redis.c"),
        os.path.join(ROOT, "runtime", "pool.c"),
        os.path.join(ROOT, "runtime", "log.c"),
        "-lssl",
        "-lcrypto",
        "-pthread",
        *flags,
    ]


def check_only():
    out_c = os.path.join(ROOT, "build", "users.gen.c")
    compile_cforge(read_entry(), out_c)
    print("ok %s" % out_c)
    return out_c


def build():
    out_c = os.path.join(ROOT, "build", "users.gen.c")
    out_bin = os.path.join(ROOT, "build", "cforge-users")
    compile_cforge(read_entry(), out_c)
    subprocess.check_call(cc_cmd(out_bin))
    return out_bin


def http_req(port, method, path, body=None, headers=None):
    data = None if body is None else body.encode()
    req = urllib.request.Request("http://127.0.0.1:%d%s" % (port, path), data=data, method=method)
    if headers:
        for k, v in headers.items():
            req.add_header(k, v)
    try:
        with urllib.request.urlopen(req, timeout=2) as resp:
            return resp.status, resp.read().decode()
    except urllib.error.HTTPError as e:
        return e.code, e.read().decode()


def wait_port(port, proc, timeout=3):
    deadline = time.time() + timeout
    while time.time() < deadline:
        if proc.poll() is not None:
            raise SystemExit("server exited early: %s" % proc.returncode)
        try:
            with socket.create_connection(("127.0.0.1", port), 0.2):
                return
        except OSError:
            time.sleep(0.05)
    raise SystemExit("server did not listen")


def redis_reachable(host="127.0.0.1", port=6379, timeout=0.5):
    try:
        with socket.create_connection((host, port), timeout) as sock:
            sock.sendall(b"PING\r\n")
            data = sock.recv(16)
            return data.startswith(b"+PONG")
    except OSError:
        return False


def bundled_redis_bin():
    return os.path.join(ROOT, "build", "redis-server-bin")


def ensure_redis_service(systemctl):
    url = os.environ.get("CFORGE_REDIS_URL", "").strip()
    if url:
        return url
    if redis_reachable():
        return "redis://127.0.0.1:6379"
    exe = bundled_redis_bin()
    if not os.path.isfile(exe):
        script = os.path.join(ROOT, "scripts", "build-redis.sh")
        if os.path.isfile(script):
            subprocess.check_call(["bash", script], cwd=ROOT)
        exe = bundled_redis_bin()
    if not os.path.isfile(exe):
        return None
    data_dir = os.path.join(ROOT, "data", "redis")
    os.makedirs(data_dir, exist_ok=True)
    unit_dir = os.path.expanduser("~/.config/systemd/user")
    os.makedirs(unit_dir, exist_ok=True)
    redis_unit = os.path.join(unit_dir, "cforge-redis.service")
    redis_unit_body = textwrap.dedent(
        f"""\
        [Unit]
        Description=CForge bundled Redis (127.0.0.1:6379)

        [Service]
        ExecStart={exe} --bind 127.0.0.1 --port 6379 --dir {data_dir} --save ""
        Restart=on-failure
        RestartSec=1

        [Install]
        WantedBy=default.target
        """
    )
    with open(redis_unit, "w", encoding="utf-8") as f:
        f.write(redis_unit_body)
    subprocess.check_call([systemctl, "--user", "daemon-reload"])
    subprocess.check_call([systemctl, "--user", "enable", "--now", "cforge-redis.service"])
    for _ in range(30):
        if redis_reachable():
            return "redis://127.0.0.1:6379"
        time.sleep(0.1)
    return None


