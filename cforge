def docker_cmd():
    path = os.environ.get("PATH", "")
    home_bin = os.path.join(os.path.expanduser("~"), "bin")
    if home_bin not in path.split(os.pathsep):
        path = home_bin + os.pathsep + path
    env = os.environ.copy()
    env["PATH"] = path
    if not env.get("DOCKER_HOST"):
        uid = os.getuid()
        sock = "/run/user/%d/docker.sock" % uid
        if os.path.exists(sock):
            env["DOCKER_HOST"] = "unix://" + sock
    plugins = os.path.join(os.path.expanduser("~"), ".docker", "cli-plugins")
    if os.path.isdir(plugins) and "DOCKER_CONFIG" not in env:
        env["DOCKER_CONFIG"] = os.path.join(os.path.expanduser("~"), ".docker")
    exe = shutil.which("docker", path=env["PATH"])
    if not exe:
        return None, env
    return exe, env


